# Required: Nebius Token Factory (embeddings + Nemotron)
NEBIUS_API_KEY=
# TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# MODEL_RUBRIC=nvidia/nemotron-3-super-120b-a12b
# MODEL_SCREEN=nvidia/Nemotron-3_5-Lightning
# MODEL_EXPLAIN=nvidia/nemotron-3-super-120b-a12b
# MODEL_EMBED=Qwen/Qwen3-Embedding-8B

# Optional services
TAVILY_API_KEY=        # without it, Tavily's keyless mode (lower rate)
OPENALEX_API_KEY=      # adds OpenAlex semantic search to the Search channel
NCBI_API_KEY=          # PubMed 3 -> 10 requests/s
NCBI_EMAIL=

# Storage and limits
CACHE_DIR=.cache/http
RUNS_DIR=.runs
MAX_CONCURRENT_RUNS=5
CORS_ORIGINS=*
