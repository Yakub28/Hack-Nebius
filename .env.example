# Required: Nebius Token Factory (embeddings + LLM)
NEBIUS_API_KEY=
# Optional: model overrides (the Token Factory catalog changes)
# NEBIUS_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Optional channels / limits
TAVILY_API_KEY=        # web + preprint search
S2_API_KEY=            # Semantic Scholar recommendations (recent papers)
NCBI_API_KEY=          # PubMed 3 → 10 requests/s

# Comma-separated origins allowed to call the API (the separately hosted UI)
CORS_ORIGINS=*
